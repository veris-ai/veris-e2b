# Python: the venv, bytecode and tool caches. uv.lock IS committed — CI runs
# `uv sync --locked`, so the lockfile is the contract, not an artifact.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
