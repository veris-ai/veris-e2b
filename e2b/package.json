{
  "name": "@veris-ai/e2b",
  "version": "0.1.1",
  "description": "Veris dependency-sandbox interception for E2B: a drop-in Sandbox subclass whose vendor API calls are answered by stateful Veris twins. Unmodified code, real hostnames, receipts.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "example": "node examples/quickstart.mjs"
  },
  "dependencies": {
    "e2b": "^2.45.0"
  },
  "keywords": [
    "veris",
    "e2b",
    "sandbox",
    "integration-testing",
    "agents",
    "mock"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veris-ai/veris-e2b.git",
    "directory": "e2b"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/veris-ai/veris-e2b#readme",
  "bugs": {
    "url": "https://github.com/veris-ai/veris-e2b/issues"
  },
  "author": "Veris AI"
}
